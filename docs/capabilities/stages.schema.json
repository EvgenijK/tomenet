{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SV functional stage catalog",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 1 },
    "stages": {
      "type": "array",
      "minItems": 66,
      "maxItems": 66,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stage" }
    }
  },
  "required": ["schemaVersion", "stages"],
  "additionalProperties": false,
  "$defs": {
    "stage": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^(A|B|C[0-9]{3})$" },
        "order": { "type": "integer", "minimum": 1 },
        "block": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "expectedOutcomeCount": { "type": "integer", "minimum": 1 },
        "scope": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "frozen": { "type": "boolean" }
      },
      "required": ["id", "order", "block", "title", "expectedOutcomeCount", "scope", "frozen"],
      "additionalProperties": false,
      "allOf": [{
        "if": {
          "properties": { "id": { "enum": ["A", "B"] } },
          "required": ["id"]
        },
        "then": {
          "properties": { "block": { "const": "baseline" }, "frozen": { "const": true } }
        },
        "else": {
          "properties": { "block": { "not": { "const": "baseline" } }, "frozen": { "const": false } }
        }
      }, {
        "if": {
          "properties": { "id": { "pattern": "^C[0-9]{3}$" } },
          "required": ["id"]
        },
        "then": {
          "properties": { "expectedOutcomeCount": { "maximum": 50 } }
        }
      }]
    }
  }
}

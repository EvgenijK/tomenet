          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "expected": {
                "type": "string",
                "minLength": 1
              },
              "applicability": {
                "enum": [
                  "required",
                  "not-applicable"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "anchor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "const": "ux"
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "anchor",
                  "role"
                ]
              }
            },
            "required": [
              "id",
              "expected",
              "applicability",
              "reason",
              "source"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "contextId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "bindingId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "keyset": {
          "enum": [
            "normal",
            "roguelike"
          ]
        },
        "platform": {
          "enum": [
            "linux",
            "windows"
          ]
        },
        "gate": {
          "type": "string",
          "minLength": 1
        }

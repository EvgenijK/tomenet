{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "consumer": {
      "const": "html-prototype"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceInventory": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/snapshot"
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "consumer",
    "manifestSha256",
    "sourceInventory",
    "coverage",
    "history"

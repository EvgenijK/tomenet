              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "anchor": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "const": "ux"
              }
            },
            "required": [
              "path",
              "sha256",
              "anchor",
              "role"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "entrypoint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "page": {
              "type": "object",

      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "const": "ux-approved"
        },
        "contractSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "approver": {
          "type": "string",
          "minLength": 1
        },
        "approvedAt": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        }
      },
      "required": [
        "id",
        "claim",
        "contractSha256",
        "approver",
        "approvedAt",
        "decision"
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilityId": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "enum": [
            "missing",
            "planned",
            "prototype-complete"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "mapping": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/mapping"
            }
          ]
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenario"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "approvals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/approval"
          },
          "minItems": 0,
          "uniqueItems": true
        }

        "contractSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observedAt": {
          "type": "string",
          "minLength": 1
        },
        "observer": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "browser": {
              "type": "string",
              "minLength": 1
            },
            "page": {
              "type": "string",
              "minLength": 1
            },
            "transport": {
              "type": "string",
              "minLength": 1
            },
            "viewport": {
              "type": "string",
              "minLength": 1
            },
            "keyset": {
              "type": "string",
              "minLength": 1
            },
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "gates": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "browser",
            "page",
            "transport",
            "viewport",
            "keyset",
            "platform",
            "gates"
          ]
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        }
      },
      "required": [
        "id",
        "scenarioId",
        "contractSha256",
        "observedAt",
        "observer",
        "environment",

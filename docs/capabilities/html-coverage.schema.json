                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                },
                "anchor": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "anchor"
              ]
            },
            "module": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                },
                "anchor": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "anchor"
              ]
            },
            "registration": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                },
                "anchor": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "anchor"
              ]
            }
          },
          "required": [
            "page",
            "module",
            "registration"
          ]

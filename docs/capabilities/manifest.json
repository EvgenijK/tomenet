  "capabilities": [
    {
      "id": "capability.status.read-hp",
      "title": "Read current and maximum hit points",
      "description": "Observe coherent current/maximum HP and boost/bar interpretation after a complete server update. This outcome excludes warning audio, full HUD and live-session acceptance.",
      "lifecycle": "active",
      "sources": [
        "source.baseline.hp",
        "source.acceptance.hp"
      ]
    },
    {
      "id": "capability.messages.read-occurrences",
      "title": "Read successive message occurrences",
      "description": "Read ordered incoming message occurrences, including identical adjacent text and the clear-topline control. Full recall, notes, chat routing and audio are separate future outcomes.",
      "lifecycle": "active",
      "sources": [
        "source.baseline.messages",
        "source.acceptance.messages",
        "source.baseline.message-occurrences"
      ]
    },
    {
      "id": "capability.request.answer-key",
      "title": "Answer a server key request",
      "description": "Read a server prompt and answer once with the original request identity and selected key, then return to the parent input context.",
      "lifecycle": "active",
      "sources": [
        "source.baseline.key-request",
        "source.acceptance.requests"
      ]
    },
    {
      "id": "capability.request.cancel-key",
      "title": "Cancel a server key request",
      "description": "Cancel a pending key request with Escape and emit exactly one zero-key reply for that request, restoring the parent input context. Other request owners have separate cancellation rules.",
      "lifecycle": "active",
      "sources": [
        "source.baseline.key-request",
        "source.acceptance.requests"
      ]
    }
  ],
  "surfaces": [
    {
      "id": "surface.status",
      "title": "Status",
      "description": "Logical status surface inside the one system window.",
      "lifecycle": "active",
      "sources": [
        "source.baseline.hp",
        "source.ux.shell"
      ]
    },
    {
      "id": "surface.messages",
      "title": "Message feed",
      "description": "Logical surface for ordered recent message occurrences.",
      "lifecycle": "active",
      "sources": [
        "source.baseline.messages"
      ]
    },
    {
      "id": "surface.request.key",
      "title": "Key request",
      "description": "Logical prompt surface retaining its server request identity.",
      "lifecycle": "active",
      "sources": [
        "source.baseline.key-request"
      ]
    }
  ],
  "actions": [
    {
      "id": "action.request.answer-key",
      "title": "Answer key request",
      "description": "Submit the selected key to the current request owner.",
      "lifecycle": "active",
      "sources": [
        "source.baseline.key-request",
        "source.protocol.key-reply"
      ]
    },
    {
      "id": "action.request.cancel-key",
      "title": "Cancel key request",
      "description": "Submit zero for Escape according to get_com and Receive_request_key.",
      "lifecycle": "active",
      "sources": [
        "source.baseline.key-input",
        "source.baseline.key-request"
      ]
    }
  ],
  "states": [
    {
      "id": "state.player.hp",
      "title": "Hit points",
      "description": "Coherent current and maximum HP, boost and bar markers.",
      "lifecycle": "active",
      "sources": [
        "source.baseline.hp"
      ]
    },
    {
      "id": "state.messages.occurrences",
      "title": "Message occurrences",
      "description": "Ordered original message occurrences, not latest text deduplication.",
      "lifecycle": "active",
      "sources": [
        "source.baseline.messages",
        "source.baseline.message-occurrences"
      ]
    },
    {
      "id": "state.request.key",
      "title": "Pending key request",
      "description": "Server identity and prompt for an unfinished key request.",
      "lifecycle": "active",
      "sources": [
        "source.baseline.key-request"
      ]
    }
  ],
  "bindings": [
    {
      "id": "binding.request.answer-key",
      "title": "answer-key",
      "description": "Gesture interpreted only by the pending key request owner.",
      "lifecycle": "active",
      "sources": [
        "source.baseline.key-input",
        "source.baseline.key-request"
      ],
      "gesture": "single accepted key",
      "actionId": "action.request.answer-key",
      "contextId": "context.request.key",
      "keyset": [
        "normal",
        "roguelike"
      ],
      "platform": [
        "linux",
        "windows"
      ]
    },

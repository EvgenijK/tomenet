{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "consumer": {
      "const": "native-sv"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capabilityId": {
            "type": "string",
            "pattern": "^[a-z]+\\.[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
          },
          "acceptanceStage": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F"
            ]
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]+\\.[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "conditions": {
            "type": "object",
            "properties": {
              "sources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z]+\\.[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "serverVersions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "builds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "platforms": {
                "type": "array",
                "items": {
                  "enum": [
                    "linux",
                    "windows"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "sources",
              "serverVersions",
              "builds",
              "platforms",
              "scope"
            ],
            "additionalProperties": false
          },
          "evidenceObligations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z]+\\.[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z]+\\.[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "id",
                "description",
                "sources"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "implementation": {
            "enum": [
              "pending",
              "native",
              "fallback"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidenceStatus": {
            "const": "pending"
          },
          "evidenceIds": {
            "type": "array",
            "maxItems": 0
          }
        },
        "required": [
          "capabilityId",
          "acceptanceStage",
          "prerequisites",
          "conditions",
          "evidenceObligations",
          "implementation",
          "reason",
          "evidenceStatus",
          "evidenceIds"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "consumer",
    "manifestSha256",
    "coverage"
  ],
  "additionalProperties": false
}

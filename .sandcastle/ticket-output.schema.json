{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "hostApprovalRequest"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "hostApprovalRequest": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "action",
        "driver",
        "renderer"
      ],
      "properties": {
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "driver": {
          "type": "string",
          "enum": [
            "wayland",
            "x11"
          ]
        },
        "renderer": {
          "type": "string",
          "enum": [
            "software",
            "opengl"
          ]
        }
      }
    }
  }
}

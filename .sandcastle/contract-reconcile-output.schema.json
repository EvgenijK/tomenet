{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "criterionEdits", "checkEdits", "criteriaToAdd", "checksToAdd"],
  "properties": {
    "summary": { "type": "string" },
    "completionScope": { "type": "string", "enum": ["implementation", "full_acceptance"] },
    "criterionEdits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "replacement"],
        "properties": { "id": { "type": "string" }, "replacement": { "$ref": "#/$defs/criterion" } }
      }
    },
    "checkEdits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "replacement"],
        "properties": { "id": { "type": "string" }, "replacement": { "$ref": "#/$defs/check" } }
      }
    },
    "criteriaToAdd": { "type": "array", "items": { "$ref": "#/$defs/criterion" } },
    "checksToAdd": { "type": "array", "items": { "$ref": "#/$defs/check" } }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement", "source", "mandatory", "applicability", "deferralReason", "owner", "checkIds"],
      "properties": {
        "id": { "type": "string" },
        "requirement": { "type": "string" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "quote"],
          "properties": { "path": { "type": "string" }, "quote": { "type": "string" } }
        },
        "mandatory": { "type": "boolean" },
        "applicability": { "type": "string", "enum": ["current", "deferred"] },
        "deferralReason": { "type": "string" },
        "owner": { "type": "string" },
        "checkIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "command", "description"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string", "enum": ["build", "core", "command", "external"] },
        "command": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}

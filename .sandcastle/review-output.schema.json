    },
    "acceptedResiduals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason",
          "risk",
          "owner",
          "returnCondition"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "returnCondition": {
            "type": "string"
          }
        }
      }

{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "criteria",
    "preserved",
    "findings",
    "resolved",
    "acceptedResiduals"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "pending"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "preserved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "defectKey",
          "area",
          "criterionIds",
          "severity",
          "category",
          "file",
          "line",
          "problem",
          "fix",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "defectKey": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "criterionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "behavior",
              "regression",
              "security",
              "data-loss",
              "protocol",
              "scope",
              "evidence",
              "cosmetic",
              "maintainability"
            ]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "problem": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "resolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
